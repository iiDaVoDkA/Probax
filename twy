Use initiative_assignment_notification.j2⁠￼ — it includes the existing FLOWR logo, BNP fonts with fallbacks, green accents and grey task rows.

Set the email subject separately to:
FLOWR - You've been assigned to a new initiative

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FLOWR - You've been assigned to a new initiative</title>
</head>
<body style="margin:0; padding:0; background-color:#ffffff;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
         style="border-collapse:collapse;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <!--[if mso]>
        <table role="presentation" width="628"><tr><td>
        <![endif]-->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
               style="max-width:628px; border-collapse:collapse;
                      font-family:BNPPSans,Helvetica,Arial,sans-serif;
                      color:#333333;">
          <!-- FLOWR logo -->
          <tr>
            <td align="center" style="padding-bottom:32px;">
              <img
                src="http://emailing.bnpparibas-am.com/flowr/projects/logo_flowr.png"
                alt="FLOWR"
                width="190"
                height="40"
                style="display:block; border:0;"
              />
            </td>
          </tr>
          <!-- Introduction -->
          <tr>
            <td style="padding:24px 0; border-top:3px solid #00915a;
                       font-family:BNPPSans-Light,Helvetica,Arial,sans-serif;
                       font-size:28px; line-height:36px;">
              You have been assigned to the following initiative:
            </td>
          </tr>
          <!-- Initiative details -->
          <tr>
            <td style="padding-bottom:12px; font-size:20px; line-height:28px;
                       font-family:BNPPSans-Bold,Helvetica,Arial,sans-serif;
                       font-weight:bold; word-wrap:break-word;">
              <a href="{{ initiative_url | e }}"
                 style="color:#00915a; text-decoration:underline;">
                {{ initiative_name | e }}
              </a>
            </td>
          </tr>
          <tr>
            <td style="padding-bottom:6px; font-size:14px; line-height:22px;">
              <strong>Initiative ID:</strong>
              {{ initiative_id | e }}
            </td>
          </tr>
          <tr>
            <td style="padding-bottom:28px; font-size:14px; line-height:22px;">
              <strong>Initiative type:</strong>
              {{ initiative_type | default('—', true) | e }}
            </td>
          </tr>
          <!-- Assigned tasks -->
          {% if tasks %}
          <tr>
            <td>
              <table width="100%" cellpadding="0" cellspacing="0"
                     style="border-collapse:collapse; table-layout:fixed;
                            font-family:BNPPSans,Helvetica,Arial,sans-serif;
                            font-size:14px; line-height:22px; color:#333333;">
                <thead>
                  <tr bgcolor="#00915a"
                      style="background-color:#00915a; color:#ffffff;">
                    <th scope="col" width="28%" align="left"
                        style="padding:12px; border-right:1px solid #ffffff;
                               font-size:12px; line-height:18px;">
                      TASK TYPE
                    </th>
                    <th scope="col" width="46%" align="left"
                        style="padding:12px; border-right:1px solid #ffffff;
                               font-size:12px; line-height:18px;">
                      TASK NAME
                    </th>
                    <th scope="col" width="26%" align="left"
                        style="padding:12px; font-size:12px; line-height:18px;">
                      EXPECTED FOR
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {% for task in tasks %}
                  <tr bgcolor="#f2f3f2" style="background-color:#f2f3f2;">
                    <td valign="top"
                        style="padding:14px 12px; border:1px solid #ffffff;
                               word-wrap:break-word;">
                      {{ task.task_type | default('—', true) | e }}
                    </td>
                    <td valign="top"
                        style="padding:14px 12px; border:1px solid #ffffff;
                               word-wrap:break-word;">
                      {{ task.task_name | e }}
                    </td>
                    <td valign="top"
                        style="padding:14px 12px; border:1px solid #ffffff;
                               word-wrap:break-word;">
                      {{ task.expected_for | default('—', true) | e }}
                    </td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </td>
          </tr>
          {% endif %}
          <!-- Footer -->
          <tr>
            <td style="padding-top:28px;">
              <table role="presentation" width="100%"
                     cellpadding="0" cellspacing="0">
                <tr>
                  <td style="border-top:1px solid #dce5df; padding-top:16px;
                             font-size:12px; line-height:18px; color:#66736b;">
                    FLOWR &middot; Initiative Pipeline
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
        <!--[if mso]>
        </td></tr></table>
        <![endif]-->
      </td>
    </tr>
  </table>
</body>
</html>

Data to pass: initiative_name, initiative_id, initiative_type, initiative_url, and tasks. Each task contains task_type, task_name and an already formatted expected_for date.