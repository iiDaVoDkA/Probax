def test_shared_member_assigns_only_an_eligible_team_assessor(self):
    cases = [
        # name, target team, assessor role, team account, exists, allowed
        ("eligible_teammate", ALPHA, True, False, True, True),
        ("different_team", BETA, True, False, True, False),
        ("missing_assessor_role", ALPHA, False, False, True, False),
        ("team_account", ALPHA, True, True, True, False),
        ("unknown_user", ALPHA, True, False, False, False),
    ]

    for name, team_id, has_role, is_team, exists, allowed in cases:
        with self.subTest(case=name):
            self.rows = {1: make_task(main=None, shared=True)}
            self.link.accountant_id = None
            self.link.team_id = ALPHA
            self.db.session.flush.reset_mock()
            self.permission_error.reset_mock()

            before = self.snapshot()
            original_relationship_id = self.rows[1].relationship_id

            users = [
                {
                    "id": A,
                    "is_team": False,
                    "teams": [{"id": ALPHA}],
                }
            ]

            if exists:
                users.append({
                    "id": B,
                    "is_team": is_team,
                    "teams": [{"id": team_id}],
                })

            assessor_users = [{"user_id": B}] if has_role else []

            with (
                patch(
                    "resources.task.task.get_users",
                    return_value=users,
                ),
                patch(
                    "resources.task.task.get_users_by_role",
                    return_value=assessor_users,
                ),
            ):
                response = self.send_patch({"main_assessor": B})

            if allowed:
                self.assert_allowed(response)
                self.assertEqual(self.rows[1].main_assessor, B)
                self.assertIs(self.rows[1].is_team_assigned, False)
                self.assertEqual(
                    self.rows[1].relationship_id,
                    original_relationship_id,
                )
            else:
                self.assert_denied(response)
                self.assertEqual(self.snapshot(), before)
                self.db.session.flush.assert_not_called()